# Banking Knowledge Agent -- example configuration.
# Copy to `.env` and adjust. NEVER commit a real `.env`.
# Every variable is optional; the defaults shown here are the built-in values.

# --- Application ---------------------------------------------------------
BKA_APP_NAME="Banking Knowledge Agent"
BKA_APP_VERSION=0.1.0
# local | test | production
BKA_ENVIRONMENT=local
BKA_DEBUG=false

# --- HTTP server ---------------------------------------------------------
BKA_HOST=127.0.0.1
BKA_PORT=8000

# --- Knowledge base ------------------------------------------------------
# Directory holding the synthetic banking documents (Markdown + front matter).
BKA_KNOWLEDGE_DIR=data/knowledge

# --- RAG pipeline --------------------------------------------------------
# Where the built vector index is written. It is a build artefact of
# BKA_KNOWLEDGE_DIR, so it is git-ignored -- rebuild it, do not commit it:
#   python -m app.rag build
BKA_VECTORSTORE_DIR=data/vectorstore

# Embedding model. Runs locally: no API key and no per-query cost. The first
# run downloads ~90 MB from Hugging Face; later runs use the local cache.
# Set to "hashing" to run the whole pipeline with no model download at all
# (deterministic but NOT semantic -- for tests and offline smoke checks).
BKA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Leave unset to auto-select (CUDA when present, else CPU). Or: cpu | cuda | mps
# BKA_EMBEDDING_DEVICE=
BKA_EMBEDDING_BATCH_SIZE=32

# Chunk budget. Leave unset to use the embedding model's own input limit,
# which is the safe default: a hardcoded number silently truncates if the
# model changes. all-MiniLM-L6-v2 reads 256 word-piece tokens.
# BKA_CHUNK_MAX_TOKENS=
BKA_CHUNK_OVERLAP_TOKENS=32

# Retrieval. min_score is the cosine floor a passage must clear to be returned;
# below it, retrieval returns nothing and the agent must say so rather than
# guess. Calibrated against this corpus: python -m app.rag calibrate
BKA_RETRIEVAL_TOP_K=5
BKA_RETRIEVAL_MIN_SCORE=0.25

# --- Agent decision (Stage 7) ---------------------------------------------
# A search whose top score is below this is "weak", and the agent may run ONE
# refined second search (the question plus a documented component name). It
# never lowers BKA_RETRIEVAL_MIN_SCORE, and only runs when a component is
# available to refine with. Measured on this corpus: documentation questions
# score 0.71-0.82, identifier-heavy ones 0.34-0.49 (docs/HANDOVER.md 7.C).
BKA_AGENT_CONFIDENT_SCORE=0.50

# --- Conversation context (Stage 8) ---------------------------------------
# A follow-up ("is it healthy?") is resolved from the previous question by
# rules, and the model is sent up to this many EARLIER QUESTIONS -- never
# earlier answers -- within this character budget (oldest dropped whole).
# A standalone question sends no history. 0 turns disables conversation context.
BKA_CONVERSATION_MAX_HISTORY_TURNS=3
BKA_CONVERSATION_MAX_HISTORY_CHARS=1000
# In-memory session store limits: turns kept per session, sessions kept at
# once (least recently used evicted), and idle seconds before a session expires.
BKA_CONVERSATION_MAX_TURNS=50
BKA_CONVERSATION_MAX_SESSIONS=1000
BKA_CONVERSATION_TTL_SECONDS=1800

# --- LLM abstraction (Stages 4 and 5) ------------------------------------
# Which provider implementation to use: mock | anthropic | openai
#
#   mock       deterministic, in-process, FREE. No network, no key, no cost.
#              The default, and it stays the default.
#   anthropic  real Anthropic API   <-- PAID. Needs BKA_LLM_API_KEY.
#   openai     real OpenAI API      <-- PAID. Needs BKA_LLM_API_KEY.
#
# Two adapters exist so the abstraction is proved rather than asserted:
# switching vendor is this one line and nothing else. Neither is "the" chosen
# vendor. Any unrecognised value fails loudly rather than falling back to the
# mock, so a stub can never masquerade as a real model.
BKA_LLM_PROVIDER=mock

# Model identifier. Leave unset to use the configured provider's own default
# (each adapter owns its own, because a model id is a vendor's string and this
# file is vendor-neutral).
# BKA_LLM_MODEL=

# Ceiling on generated tokens: a runaway-generation guard, not a target. It is
# set well above the length of a support answer so that a provider billing
# reasoning tokens as output cannot truncate a valid answer. Answer length is
# controlled by the system prompt, not by this number.
BKA_LLM_MAX_TOKENS=4096

# Transport behaviour for whichever adapter is written next.
BKA_LLM_TIMEOUT_SECONDS=60.0
BKA_LLM_MAX_RETRIES=2

# Context budget. The model receives retrieved passages, never the knowledge
# base. Passages are dropped whole once a budget is reached, never truncated
# mid-passage: half a configuration table reads as complete and is wrong.
BKA_LLM_CONTEXT_MAX_CHUNKS=5
BKA_LLM_CONTEXT_MAX_CHARS=12000

# --- Evaluation (Stage 11) -----------------------------------------------
# The question set scored by `python -m app.eval` and the evaluation tests.
# Its score floors live inside the file, beside the questions they apply to.
# The evaluation is FREE by default (mock provider); only `--paid` uses the
# provider above, and it refuses unless that provider is paid AND a key is set.
BKA_EVAL_DATASET_PATH=data/eval/questions.yaml

# --- Logging and tracing -------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
BKA_LOG_LEVEL=INFO
# console | json   (use json in Docker / production)
BKA_LOG_FORMAT=console
BKA_LOG_DIR=logs
BKA_LOG_TO_FILE=true

# --- Secrets -------------------------------------------------------------
# The LLM API key. Provided by the environment ONLY -- never hardcoded, never
# committed, never logged (it is held as a pydantic SecretStr, so it renders
# as '**********' in any repr or dump).
#
# Leave it UNSET, which is how this repository ships and how its suite runs.
#
# It is only read when BKA_LLM_PROVIDER is 'anthropic' or 'openai'. Those are
# PAID APIs. Spending therefore needs TWO deliberate changes -- switch the
# provider AND supply a key -- and neither adapter can even be constructed
# without one, so a half-made change fails loudly instead of quietly billing.
# The default 'mock' provider ignores this variable entirely.
# BKA_LLM_API_KEY=
